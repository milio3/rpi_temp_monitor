# ========================================================
# RPi Temp Monitor — Variables de Configuración
# ========================================================

# Parámetros de Entorno
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
TZ=Europe/Madrid

# Persistencia SQLite WAL
DATABASE_URL=sqlite:////app/data/database.db

# Configuración del Sensor Térmico
TEMP_SENSOR_PATH=/sys/class/thermal/thermal_zone0/temp
CHECK_INTERVAL=600
WARNING_TEMP=60.0
CRITICAL_TEMP=75.0
THROTTLING_TEMP=80.0
